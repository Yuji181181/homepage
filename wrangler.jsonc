{
  "name": "homepage",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "homepage-db",
      "database_id": "38c4f25c-29d0-4f72-b0ba-437bcfd53311",
      "migrations_dir": "src/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "homepage-assets"
    }
  ]
}
